# Salin ke .env.local lalu isi kredensial Aiven MySQL
# (Aiven Console -> service -> tab Overview)

DB_HOST=your-service.aivencloud.com
DB_PORT=your-port
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=defaultdb

# Base64 dari ca.pem. Buat dengan: base64 -i ca.pem | tr -d '\n'
# (Linux: base64 -w0 ca.pem)
DB_CA_CERT=your-base64-ca-certificate
